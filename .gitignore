# =========================================================================
# OmniRoute Git Ignore Rules
# =========================================================================
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# project-specific directories
OmniRoute/.omnivscodeagent/
OmniRoute/omnirouteCloud/
OmniRoute/omnirouteSite/
OmniRoute/_cache/
OmniRoute/_ideia/
OmniRoute/_mono_repo/
OmniRoute/_references/
OmniRoute/_tasks/
OmniRoute/.agents/**
OmniRoute/.claude/**
OmniRoute/.gemini/**
OmniRoute/.config/**
OmniRoute/.data/**
OmniRoute/.logs/**
OmniRoute/.tests/**
OmniRoute/.coverage/**
OmniRoute/coverage/
OmniRoute/.dist/**
OmniRoute/.next/**
OmniRoute/.build/**
OmniRoute/.out/**

# Stryker mutation testing — ephemeral sandbox + generated reports (never commit)
OmniRoute/.stryker-tmp/
OmniRoute/reports/mutation/
OmniRoute/stryker-output-*.json


# Memory Bank and Cursor rules (local-only AI agent context)
OmniRoute/memory-bank/
OmniRoute/.cursor/rules/core.mdc
OmniRoute/.cursor/rules/memory-bank.mdc

# Claude Code local state — runtime files only; shared commands at .claude/commands/ are tracked
OmniRoute/.claude/scheduled_tasks.lock
OmniRoute/.claude/scheduled_tasks/
OmniRoute/.claude/sessions/
OmniRoute/.claude/state.json
OmniRoute/.claude/settings.local.json

# Root-level underscore-prefixed directories (private/draft — never commit)
/OmniRoute/_*/

# Draft features documentation (internal only)
OmniRoute/docs/new-features/

# dependencies
OmniRoute/node_modules/
# Also ignore a root node_modules SYMLINK (worktree setups symlink it from the main
# checkout). The trailing-slash pattern above only matches a directory, so without this
# a symlink named node_modules could be staged by `git add -A` and committed.
/OmniRoute/node_modules
OmniRoute/*.map
OmniRoute/.DS_Store

# Obsidian sync plugin — committed for community distribution
!OmniRoute/obsidian-plugin/
OmniRoute/obsidian-plugin/node_modules/

# Serena AI assistant config (local-only tool, not project code)
OmniRoute/.serena/

# debug
OmniRoute/npm-debug.log*
OmniRoute/yarn-debug.log*
OmniRoute/yarn-error.log*
OmniRoute/.pnpm-debug.log*

# env files (can opt-in for committing if needed)
OmniRoute/.env*
!OmniRoute/.env.example
!OmniRoute/.env.homolog.example
# Provider API keys (never commit)
OmniRoute/*.api-key
OmniRoute/.nvidia-api-key

# vercel
OmniRoute/.vercel

# typescript
OmniRoute/*.tsbuildinfo
OmniRoute/next-env.d.ts

# data and logs
OmniRoute/data/
OmniRoute/.data/
OmniRoute/logs/*
OmniRoute/test_output.log

# analysis directories (generated, not tracked)
OmniRoute/.analysis/
OmniRoute/antigravity-manager-analysis/
OmniRoute/.sisyphus/
OmniRoute/.plans/

# open-sse tests
OmniRoute/open-sse/test/*

# Ignore vscode AI rules
OmniRoute/.github/instructions/codacy.instructions.md

# Playwright
OmniRoute/.playwright-mcp/
OmniRoute/test-results/
OmniRoute/playwright-report/
OmniRoute/blob-report/
OmniRoute/cloud/
OmniRoute/.tmp/

# Security Analysis (standalone project with own git)
OmniRoute/security-analysis/

# Deploy workflow (contains sensitive VPS credentials)
OmniRoute/clipr/
OmniRoute/app.log
OmniRoute/*.tgz
OmniRoute/.gh-discussions.json
OmniRoute/deploy.sh
OmniRoute/docker-compose.minimal.yml


# Backup directories
OmniRoute/app.__qa_backup/
OmniRoute/.app-build-backup-*/
OmniRoute/backup/

# Build intermediates (.build/) and shippable standalone (dist/).
# These are fully reproducible from source; never committed.
# Layer 1: Next.js now writes to .build/next (was .next); assembled bundle → dist/
# (Previously /app/ was the standalone output; renamed to /dist/ in Layer 1.)
/OmniRoute/.build/
/OmniRoute/dist/
/OmniRoute/.next/

# Electron
OmniRoute/electron/dist-electron/
OmniRoute/electron/node_modules/
OmniRoute/icon.iconset/

# VS Code Extension (independent Git repo)
OmniRoute/vscode-extension/

# SQLite residual files
OmniRoute/*.sqlite-shm
OmniRoute/*.sqlite-wal
OmniRoute/*.sqlite-journal

# IDEA
OmniRoute/.idea/

# Local OpenCode agent config
OmniRoute/.config/

# Empty/dangling files
OmniRoute/typescript

# Gemini Antigravity agent data
OmniRoute/.gemini/

# Superpowers plans/specs (internal tooling, not project code)
OmniRoute/docs/superpowers/
# Superpowers visual-companion brainstorm mockups (ephemeral)
OmniRoute/.superpowers/

# TIA test-impact map — generated at runtime in CI (build-test-impact-map.mjs), never committed (~21MB)
OmniRoute/config/quality/test-impact-map.json

# GitNexus local index
OmniRoute/.gitnexus
OmniRoute/.worktrees
OmniRoute/bin/omniroute.mjs

# Consistent with .dockerignore / .npmignore
OmniRoute/.omc/
OmniRoute/audit-report.json
OmniRoute/bun.lock

# Private environment variables for .http-client
OmniRoute/http-client.private.env.json

# Note: _ideia/ (feature-triage drafts) is fully covered by the /_*/ rule above
