{
  "name": "tailieu-hou-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "tailieu_hou_extend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "npx concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm run start -w backend",
    "start:frontend": "npm run preview -w frontend",
    "start": "npx concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0"
  }
}
